{
  "name": "ai_playwright_project",
  "version": "1.0.0",
  "description": "Playwright E2E test suite with Page Object Model, typed fixtures, and API helpers",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:auth": "npx playwright test tests/auth",
    "test:cart": "npx playwright test tests/cart",
    "test:products": "npx playwright test tests/products",
    "test:account": "npx playwright test tests/account",
    "test:ci": "npx playwright test --reporter=html,json"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "typescript",
    "page-object-model"
  ],
  "author": "Alex-dins",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.12.2",
    "dotenv": "^17.2.3",
    "typescript": "^5.9.3"
  }
}
